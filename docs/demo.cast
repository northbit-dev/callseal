[0.051629, "o", "\u001b[1m\r\nCallSeal — prove your trading track record, never leak a call.\u001b[0m\r\n\u001b[2mEvery step below runs the compiled Compact circuits (compact-runtime). A failed assert = no valid proof.\r\n\u001b[0m\r\n"]
